10 REM DAYBOOK - QIJUZHU INDEXER  (BASIC, 1970s home computers)
20 REM APPLE II / C64 / BBC BASIC COMPATIBLE SUBSET
30 REM USAGE: SET V$(1),P$(1) ... THEN RUN
40 HOME : REM OR CLS ON OTHER SYSTEMS
50 V=3: REM NUMBER OF VOLUMES
60 DIM V$(V),P$(V)
70 V$(1)="COLLAB": P$(1)="QIJUZHU.TXT"
80 V$(2)="CIHAI":  P$(2)="CIHAI.TXT"
90 V$(3)="DAZONGSHI": P$(3)="DZ.TXT"
100 FOR K=1 TO V
110   PRINT "VOL ";V$(K);" -> ";P$(K)
120   GOSUB 300
130 NEXT K
140 END
300 REM COUNT ENTRIES IN P$(K)
310 N=0
320 ON ERROR GOTO 390
330 OPEN P$(K) FOR INPUT AS #1
340 IF EOF(1) THEN 380
350 LINE INPUT #1, L$
360 IF LEN(L$)>17 THEN IF MID$(L$,1,1)="[" THEN IF MID$(L$,12,1)=":" THEN N=N+1
370 GOTO 340
380 CLOSE #1
390 PRINT "  ENTRIES: ";N
400 RETURN
