def write_json_cfg(path, label, st):
    entry = {'type': 'stdio', 'command': SIGNER, 'args': [label], 'env': client_env()}
    old = None
    if os.path.exists(path):
        try:
            with open(path, encoding='utf-8') as f:
                old = json.load(f)
        except Exception:
            old = None
    # 合并而不是覆盖：保留用户已有的其他 MCP 服务与顶层键。深拷贝，避免原地改到 old。
    # Merge, do not clobber: preserve other servers/top-level keys. Deep-copy so old is not mutated.
    want = copy.deepcopy(old) if isinstance(old, dict) else {}
    servers = want.get('mcpServers')
    if not isinstance(servers, dict):
        servers = {}
    servers['daybook'] = entry
    want['mcpServers'] = servers
    if old == want:
        out('GREEN 配置：%s 无变化' % path)
        return
    backup(path, st)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w', encoding='utf-8') as f:
        json.dump(want, f, ensure_ascii=False, indent=2)
        f.write('\n')
    out('GREEN 配置：%s 已写入' % path)


def write_dsh_cfg(st):
    env = client_env()
    block = ('- id: mcp-manager\n'
             '  name: "@deepseek-ai/dsh-mcp-manager"\n'
             '  config:\n'
             '    servers:\n'
             '      daybook:\n'
             '        transport: stdio\n'
             '        command: %s\n'
             '        args: ["deepseek-harness"]\n'
             '        env:\n' % SIGNER)
    for k, v in env.items():
        block += '          %s: %s\n' % (k, v)
    old = open(DSH_CFG, encoding='utf-8').read() if os.path.exists(DSH_CFG) else ''
    lines = old.splitlines(keepends=True)
    start = next((i for i, l in enumerate(lines) if l.strip() == '- id: mcp-manager'), None)
    if start is None:
        new = old.rstrip() + ('\n\n' if old.strip() else '') + block
    else:
        end = len(lines)
        for j in range(start + 1, len(lines)):
            if lines[j].startswith('- id:'):
                end = j
                break
        new = ''.join(lines[:start]) + block + ''.join(lines[end:])
    if new == old:
        out('GREEN 配置：%s 无变化' % DSH_CFG)
        return
    backup(DSH_CFG, st)
    os.makedirs(os.path.dirname(DSH_CFG), exist_ok=True)
    with open(DSH_CFG, 'w', encoding='utf-8') as f:
        f.write(new)
    out('GREEN 配置：%s 已写入' % DSH_CFG)


def write_trae_whitelist(st):
    if not os.path.exists(TRAE_DB):
        out('YELLOW TRAE 白名单：找不到 state.vscdb')
        return
    backup(TRAE_DB, st)
    try:
        con = sqlite3.connect(TRAE_DB)
        cur = con.cursor()
        row = cur.execute(
            "select value from ItemTable where key='currentAgentData_4021362611466836'").fetchone()
        if not row:
            out('YELLOW TRAE 白名单：未找到 currentAgentData 键')
            con.close()
            return
        data = json.loads(row[0])
        names = data.setdefault('mcp_list', [])
        if 'daybook' not in names:
            names.append('daybook')
            cur.execute(
                "update ItemTable set value=? where key='currentAgentData_4021362611466836'",
                (json.dumps(data, ensure_ascii=False),))
            con.commit()
            out('GREEN TRAE 白名单：已加入 daybook')
        else:
            out('GREEN TRAE 白名单：已包含 daybook')
        con.close()
    except Exception as e:
        out('YELLOW TRAE 白名单：写入失败 %s' % str(e)[:120])


def _readline_deadline(stream, seconds):
    """带截止时间的 readline；超时返回 None（不阻塞）。
    readline with a deadline; returns None on timeout instead of blocking forever."""
    q = queue.Queue()

    def _rd():
        try:
            q.put(('ok', stream.readline()))
        except Exception as e:                      # noqa: BLE001
            q.put(('err', e))

    t = threading.Thread(target=_rd, daemon=True)
    t.start()
    try:
        kind, val = q.get(timeout=seconds)
    except queue.Empty:
        return None
    if kind == 'err':
        raise val
    return val


def handshake(label):
    timeout = float(os.environ.get('DAYBOOK_HANDSHAKE_TIMEOUT', '20'))
    # 独立进程组：超时清理时连同代理拉起的后端一起杀，不留孤儿。
    # Separate process group: on timeout kill the proxy and its backend together, no orphans.
    p = subprocess.Popen([SIGNER, label], text=True, bufsize=1,
                         stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                         stderr=subprocess.DEVNULL, start_new_session=True,
                         env={**os.environ, **client_env()})
    try:
        p.stdin.write(json.dumps({'jsonrpc': '2.0', 'id': 1, 'method': 'initialize',
                                  'params': {'protocolVersion': '2024-11-05'}}) + '\n')
        p.stdin.flush()
        line = _readline_deadline(p.stdout, timeout)
        if line is None:
            return False, '握手超时（%g 秒）：代理未返回 initialize' % timeout
        if not line:
            return False, '无响应'
        p.stdin.write(json.dumps({'jsonrpc': '2.0', 'id': 2, 'method': 'tools/list'}) + '\n')
        p.stdin.flush()
        line = _readline_deadline(p.stdout, timeout)
        if line is None:
            return False, '握手超时（%g 秒）：代理未返回 tools/list' % timeout
        obj = json.loads(line)
        names = [t.get('name') for t in (obj.get('result') or {}).get('tools', [])]
        return (len(names) == 4 and 'daybook_append' in names,
                'tools=%d append=%s' % (len(names), 'daybook_append' in names))
    except Exception as e:
        return False, str(e)[:80]
    finally:
        try:
            p.stdin.close()
        except Exception:
            pass
        try:
            p.wait(timeout=3)
        except Exception:
            try:
                os.killpg(os.getpgid(p.pid), signal.SIGKILL)
            except Exception:
                p.kill()


def secret_scan():
    """泄漏扫描：读本机密钥值，在配置/日志/源码树里找完整 key；命中即红。
    不打印 key，只打印指纹前缀与命中路径。
    Leak scan: search the configs/logs/source tree for each full key; never print the key."""
    keys = {}
    kd = os.path.join(LEDGER, '.daybook_keys')
    if os.path.isdir(kd):
        for fn in os.listdir(kd):
            if not fn.endswith('.key'):
                continue
            p = os.path.join(kd, fn)
            try:
                v = open(p, encoding='utf-8').read().strip()
            except OSError:
                continue
            if KEY_RE.match(v):
                keys[fn[:-4]] = v
    if not keys:
        return [], 0
    roots = [BASE]
    if SOURCE and os.path.abspath(SOURCE) != os.path.abspath(BASE):
        roots.append(SOURCE)
    skip_dirs = {'.git', '__pycache__', 'node_modules', '.venv', 'dist', 'build',
                 '.pytest_cache'}
    hits = []
    scanned = 0
    for root in roots:
        for dirpath, dirs, files in os.walk(root):
            dirs[:] = [d for d in dirs if d not in skip_dirs]
            # 密钥文件自身不是泄漏（它就在该在的地方）
            if os.path.abspath(dirpath) == os.path.abspath(kd):
                continue
            for fn in files:
                p = os.path.join(dirpath, fn)
                try:
                    if os.path.getsize(p) > 2 * 1024 * 1024:
                        continue
                    raw = open(p, 'rb').read()
                except OSError:
                    continue
                scanned += 1
                for aid, key in keys.items():
                    if key.encode() in raw:
                        hits.append((aid, p))
    return hits, scanned


def config_digest():
    rows = []
    for p in (TRAE_CFG, WB_CFG, DSH_CFG):
        rows.append('%s=%s' % (os.path.basename(p), sha256_file(p)[:16] or 'missing'))
    return ' '.join(rows)


def cmd_install():
    st = load_state()
    if not SOURCE:
        die('运行副本', '找不到同级三包根；用 --source 指定发行树根')
    out('== daybook-setup install 4.0.7 ==')
    sync_runtime(st)
    ensure_ledger(st)
    ensure_instance()
    ids = []
    for name, label in IDENTITIES:
        aid = ensure_identity(name)
        ids.append((label, aid))
    install_signer(st)
    bad_keys = verify_key_registry()
    if bad_keys:
        for aid, fp, why in bad_keys:
            out('RED   密钥登记：%s 指纹 %s %s' % (aid, fp or '∅', why))
        die('密钥登记', '%d 把 key 未能在本 BASE 注册卷找到对应指纹（拒绝复制来的 key）'
            % len(bad_keys))
    out('GREEN 密钥登记：%d 把 key 均在本 BASE 注册卷有指纹'
        % len([n for n in os.listdir(os.path.join(LEDGER, '.daybook_keys'))
               if n.endswith('.key')]) if os.path.isdir(os.path.join(LEDGER, '.daybook_keys'))
        else 'GREEN 密钥登记：0 把（无密钥目录）')
    write_json_cfg(TRAE_CFG, 'trae', st)
    write_trae_whitelist(st)
    write_json_cfg(WB_CFG, 'workbuddy', st)
    write_dsh_cfg(st)
    for label, _aid in ids:
        ok, why = handshake(label)
        if not ok:
            die('自检 %s' % label, why)
        out('GREEN 自检：%s 代理握手 %s' % (label, why))
    hits, scanned = secret_scan()
    if hits:
        for aid, p in hits:
            out('RED   密钥泄漏：%s 的完整密钥出现在 %s' % (aid, p))
        die('密钥', '完整密钥出现在配置/日志/源码树（%d 处）' % len(hits))
    out('GREEN 密钥扫描：0 命中（扫描 %d 文件）' % scanned)
    out('GREEN 配置指纹：%s' % config_digest())
    st['installed_at'] = time.strftime('%Y-%m-%d %H:%M:%S')
    save_state(st)
    out('== install 完成 ==')
    out('还差你点一下：')
    out('  1) TRAE：新会话里若弹出 daybook MCP 信任，点“信任/允许”。')
    out('  2) WorkBuddy：MCP 面板若弹出“首次连接此 MCP 服务需要您的信任确认”，点“信任”。')
    out('  3) WorkBuddy CLI：运行 codebuddy 后输入 /login（仅本人操作）。')
    return 0


def cmd_doctor():
    out('== daybook-setup doctor 4.0.7 ==')
    checks = []
    sv = version_of(RUNTIME)
    checks.append(('运行副本 4.0.7', 'GREEN' if '4.0.7' in sv else 'RED', sv or '缺失'))
    checks.append(('账本根', 'GREEN' if os.path.isdir(LEDGER) else 'RED', LEDGER))
    for name, _label in IDENTITIES:
        hit = [r for r in registry() if r['name'] == name]
        if not hit:
            checks.append(('身份 %s' % name, 'RED', '未注册'))
            continue
        ok, why = key_shape(key_path(hit[0]['id']))
        checks.append(('身份 %s' % name, 'GREEN' if ok else 'RED',
                       '%s · 密钥 %s' % (hit[0]['id'], why)))
    ps = subprocess.run(['ps', 'ax', '-o', 'pid,command'], capture_output=True, text=True)
    plines = ps.stdout.splitlines()
    for name, label in IDENTITIES:
        lines = [l for l in plines if 'signer/proxy.py' in l
                 and SIGNER_DIR in l and '--label %s' % label in l]
        if lines:
            checks.append(('代理 %s' % label, 'GREEN', '运行中'))
        else:
            checks.append(('代理 %s' % label, 'YELLOW', '客户端尚未拉起'))
    checks.append(('TRAE 配置', 'GREEN' if os.path.exists(TRAE_CFG) else 'RED', TRAE_CFG))
    checks.append(('WorkBuddy 配置', 'GREEN' if os.path.exists(WB_CFG) else 'RED', WB_CFG))
    dsh = open(DSH_CFG, encoding='utf-8').read() if os.path.exists(DSH_CFG) else ''
    checks.append(('DSH 配置', 'GREEN' if 'daybook' in dsh else 'RED', DSH_CFG))
    signer_ok = os.path.exists(SIGNER) and os.path.exists(os.path.join(SIGNER_DIR, 'proxy.py'))
    checks.append(('签名代理随包件', 'GREEN' if signer_ok else 'RED', SIGNER_DIR))
    ok, why = handshake('trae')
    checks.append(('璇玑工具面', 'GREEN' if ok else 'RED', why))
    bad_keys = verify_key_registry()
    checks.append(('密钥登记指纹', 'GREEN' if not bad_keys else 'RED',
                   '全部有登记' if not bad_keys
                   else '; '.join('%s:%s %s' % (a, f or '∅', w) for a, f, w in bad_keys)))
    dup = active_instance_warnings()
    checks.append(('同身份多实例', 'WARN' if dup else 'GREEN',
                   '；'.join('%s ← %s' % (a, ', '.join(t)) for a, t in dup)
                   if dup else '无（同一身份只有 1 个活跃实例）'))
    hits, scanned = secret_scan()
    checks.append(('密钥泄漏扫描', 'GREEN' if not hits else 'RED',
                   '0 命中（扫描 %d 文件）' % scanned if not hits
                   else '%d 命中' % len(hits)))
    for aid, p in hits:
        checks.append(('泄漏 %s' % aid, 'RED', p))
    checks.append(('派发器', 'YELLOW', '4.0.7 不随包、不承诺唤醒'))
    checks.append(('TRAE 唤醒', 'YELLOW', '无 headless；仅 GUI'))
    checks.append(('WorkBuddy 唤醒', 'YELLOW', '需本人 /login + UI 信任'))
    for name, status, why in checks:
        out('%-4s %-18s %s' % (status, name, why))
    return 0


def cmd_show():
    rows = registry()
    out('== 注册身份 ==')
    for r in rows:
        ok, why = key_shape(key_path(r['id']))
        out('%s｜%s｜密钥 %s' % (r['id'], r['name'], why if ok else 'BAD:' + why))
    path = os.path.join(LEDGER, '协作卷.txt')
    if not os.path.exists(path):
        out('YELLOW 协作卷不存在：%s' % path)
        return 0
    lines = open(path, encoding='utf-8').read().splitlines()
    out('== 协作卷（末 20 条）==')
    for line in lines[-20:]:
        out(line)
    return 0


def cmd_uninstall():
    st = load_state()
    out('== daybook-setup uninstall ==')
    for path, rec in st.get('backups', {}).items():
        if rec.get('existed') and rec.get('path') and os.path.exists(rec['path']):
            shutil.copy2(rec['path'], path)
            out('GREEN 已还原 %s' % path)
        elif not rec.get('existed') and os.path.exists(path):
            os.remove(path)
            out('GREEN 已移除安装时新建的 %s' % path)
    for _name, label in IDENTITIES:
        # 只停本 BASE 的代理，避免误杀另一套安装（同 label 不同目录）。
        # Only stop proxies under this BASE; do not kill another install with the same label.
        subprocess.run(['pkill', '-f', '%s/proxy.py.*--label %s' % (SIGNER_DIR, label)],
                       capture_output=True)
    out('GREEN 代理进程已停')
    if os.path.exists(PLIST):
        subprocess.run(['launchctl', 'bootout', 'gui/%d/com.daybook.dispatcher' % os.getuid()],
                       capture_output=True)
        os.remove(PLIST)
        out('GREEN 旧派发器已停并移除 plist')
    if st.get('runtime_created') and os.path.isdir(RUNTIME):
        shutil.rmtree(RUNTIME)
        out('GREEN 已移除安装时创建的运行副本')
    out('KEEP 账本保留：%s' % LEDGER)
    out('== uninstall 完成 ==')
    return 0


def main():
    ap = argparse.ArgumentParser(prog='daybook-setup')
    ap.add_argument('cmd', choices=['install', 'doctor', 'uninstall', 'show'])
    ap.add_argument('--base', default=os.path.expanduser('~/.daybook-mailroom'))
    ap.add_argument('--source', default=None, help='三包同级根（含 daybook-mcp/ 与 daybook-orch/）')
    a = ap.parse_args()
    configure(a.base, a.source)
    return {'install': cmd_install, 'doctor': cmd_doctor,
            'uninstall': cmd_uninstall, 'show': cmd_show}[a.cmd]()


if __name__ == '__main__':
    sys.exit(main())
