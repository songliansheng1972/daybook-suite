def detect_source():
    """发行树：<root>/daybook-mcp/setup/daybook-setup ⇒ root 有三个同级包。
    Release tree: <root>/daybook-mcp/setup/daybook-setup ⇒ root holds the three sibling packages."""
    for cand in (SUITE_ROOT, PKG_ROOT):
        if os.path.exists(os.path.join(cand, 'daybook-mcp', 'mcp_server.py')):
            return cand
    return ''


def out(msg):
    print(msg, flush=True)


def die(step, msg):
    out('RED   %s：%s' % (step, msg))
    out('已停止，未继续下一步。回滚：daybook-setup uninstall')
    sys.exit(2)


def load_state():
    try:
        with open(STATE, encoding='utf-8') as f:
            return json.load(f)
    except Exception:
        return {}


def save_state(st):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(st, f, ensure_ascii=False, indent=1)
    os.replace(tmp, STATE)


def backup(path, st):
    rec = st.setdefault('backups', {}).get(path)
    if rec is not None:
        return rec
    if os.path.exists(path):
        b = path + '.bak-daybook-setup-' + time.strftime('%Y%m%d-%H%M%S')
        shutil.copy2(path, b)
        rec = {'existed': True, 'path': b}
    else:
        rec = {'existed': False, 'path': None}
    st['backups'][path] = rec
    save_state(st)
    return rec


def sha256_file(path):
    try:
        h = hashlib.sha256()
        with open(path, 'rb') as f:
            for chunk in iter(lambda: f.read(65536), b''):
                h.update(chunk)
        return h.hexdigest()
    except OSError:
        return ''


def version_of(root):
    p = os.path.join(root, 'daybook-mcp', 'version.txt')
    try:
        with open(p, encoding='utf-8') as f:
            return f.readline().strip()
    except OSError:
        return ''


def sync_runtime(st):
    if not SOURCE:
        die('运行副本', '找不到同级三包根（需要 daybook-mcp/ 与 daybook-orch/）；用 --source 指定')
    for need in ('daybook-mcp', 'daybook-orch'):
        if not os.path.isdir(os.path.join(SOURCE, need)):
            die('运行副本', '源缺 %s：%s' % (need, os.path.join(SOURCE, need)))
    sv = version_of(SOURCE)
    if '4.0.7' not in sv:
        die('运行副本', '源不是 4.0.7：%s' % (sv or '无 version.txt'))
    if version_of(RUNTIME) == sv:
        out('GREEN 运行副本：已是最新 %s' % sv)
        return
    tmp = RUNTIME + '.tmp-' + str(os.getpid())
    shutil.rmtree(tmp, ignore_errors=True)
    os.makedirs(tmp, exist_ok=True)
    for d in ('daybook', 'daybook-mcp', 'daybook-orch'):
        s = os.path.join(SOURCE, d)
        if os.path.isdir(s):
            shutil.copytree(s, os.path.join(tmp, d),
                            ignore=shutil.ignore_patterns('__pycache__', '*.pyc',
                                                          '.daybook_keys'))
    if not st.get('runtime_created'):
        st['runtime_created'] = not os.path.isdir(RUNTIME)
    old = RUNTIME + '.old-' + str(os.getpid())
    if os.path.isdir(RUNTIME):
        os.replace(RUNTIME, old)
    os.replace(tmp, RUNTIME)
    shutil.rmtree(old, ignore_errors=True)
    out('GREEN 运行副本：已同步 %s' % sv)


def ensure_ledger(st):
    if not os.path.isdir(LEDGER):
        os.makedirs(LEDGER, exist_ok=True)
        st['ledger_created'] = True
        # 优先用发行 conf（卷表挂 sample/ 三卷），否则空卷表会让璇玑启动即 2。
        # Prefer the distribution conf (three sample volumes); an empty volume table
        # would make Xuanji exit 2 on startup.
        conf = os.path.join(RUNTIME, 'daybook', 'daybook.conf')
        if not os.path.exists(conf):
            conf = os.path.join(RUNTIME, 'daybook-mcp', 'daybook.conf')
        if os.path.exists(conf):
            shutil.copy2(conf, os.path.join(LEDGER, 'daybook.conf'))
        sample = os.path.join(RUNTIME, 'daybook', 'sample')
        if os.path.isdir(sample) and not os.path.exists(os.path.join(LEDGER, 'sample')):
            shutil.copytree(sample, os.path.join(LEDGER, 'sample'),
                            ignore=shutil.ignore_patterns('__pycache__', '*.pyc'))
        out('GREEN 账本根：已新建 %s' % LEDGER)
    else:
        out('GREEN 账本根：已存在，未动 %s' % LEDGER)


def ensure_instance():
    """安装期确保实例号；已有则保留（幂等）。克隆会连同文件复制，运行时 token 另拼路径哈希。
    Ensure an install-time instance id; keep the existing one (idempotent). A clone copies the
    file; the runtime token appends a path hash so two copies at different paths differ."""
    p = os.path.join(LEDGER, '实例.json')
    try:
        with open(p, encoding='utf-8') as f:
            d = json.load(f)
        if d.get('实例'):
            return d['实例']
    except (OSError, ValueError):
        pass
    rec = {'实例': uuid.uuid4().hex,
           '生成': time.strftime('%Y-%m-%d %H:%M:%S'),
           'BASE': os.path.abspath(BASE)}
    # 走 safeio 既有写口（临时文件 + 原子替换）；安装中断只会留旧完整文件或没有文件。
    # Use safeio's existing write path (temp file + atomic replace); an interrupted install
    # leaves either the old complete file or no file — never a half-written one.
    sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
    from safeio import locked, WriteMode
    with locked(LEDGER) as lr:
        lr.write(lr.root.rel_of(p, 'setup.ensure_instance'),
                 json.dumps(rec, ensure_ascii=False),
                 mode=WriteMode.REPLACE, perm=0o644)
    return rec['实例']


def active_instance_warnings(timeout=120):
    """同一 agent_id 出现两个活跃实例 ⇒ 告警（不硬拒）。
    Warn (never hard-reject) when one agent_id shows two active instances."""
    p = os.path.join(LEDGER, '心跳卷.txt')
    try:
        lines = open(p, encoding='utf-8').read().splitlines()
    except OSError:
        return []
    now = time.time()
    seen = {}
    for line in lines:
        if '[心跳]' not in line or 'alive' not in line:
            continue
        parts = [x.strip(' []') for x in line.split(']') if x.strip()]
        if len(parts) < 3 or not parts[2].startswith('ag-'):
            continue
        ts = None
        for fmt in ('%Y-%m-%d %H:%M:%S', '%Y-%m-%d %H:%M'):
            try:
                ts = time.mktime(time.strptime(parts[0], fmt))
                break
            except ValueError:
                continue
        if ts is None or ts < now - timeout:
            continue
        m = re.search(r'\[实例=([^\]]+)\]', line)
        tok = m.group(1) if m else '∅'
        seen.setdefault(parts[2], set()).add(tok)
    return [(a, sorted(t)) for a, t in sorted(seen.items()) if len(t) > 1]


def registry():
    p = os.path.join(LEDGER, '注册卷.txt')
    rows = []
    try:
        for line in open(p, encoding='utf-8'):
            m = re.search(r'\[注册\]\s*\[(ag-[0-9a-f]+)\]\s*\[([^\]]+)\]'
                          r'(?:\s*\[[^\]]*\])?'
                          r'(?:\s*\[fp=([0-9a-f]{64})\])?', line)
            if m:
                rows.append({'id': m.group(1), 'name': m.group(2), 'fp': m.group(3)})
    except FileNotFoundError:
        pass
    return rows


def verify_key_registry():
    """每把 key 的指纹必须能在本 BASE 注册卷找到登记。
    Every key fingerprint must be registered in this BASE's registry volume.
    返回 [(agent_id, 指纹前缀, 原因)]；不打印密钥。
    Returns [(agent_id, fingerprint prefix, reason)]; never prints the secret."""
    known = {r['id']: r.get('fp') for r in registry()}
    kd = os.path.join(LEDGER, '.daybook_keys')
    bad = []
    if not os.path.isdir(kd):
        return bad
    for fn in sorted(os.listdir(kd)):
        if not fn.endswith('.key'):
            continue
        aid = fn[:-4]
        p = os.path.join(kd, fn)
        try:
            val = open(p, encoding='utf-8').read().strip()
        except OSError as e:
            bad.append((aid, '', '不可读：%s' % type(e).__name__))
            continue
        fp = hashlib.sha256(val.encode('utf-8')).hexdigest()
        if aid not in known:
            bad.append((aid, fp[:12], '未在本 BASE 注册卷登记'))
        elif not known[aid]:
            bad.append((aid, fp[:12], '注册卷无指纹登记（请重新 join）'))
        elif known[aid] != fp:
            bad.append((aid, fp[:12], '与注册卷指纹不符'))
    return bad


def key_path(agent_id):
    return os.path.join(LEDGER, '.daybook_keys', agent_id + '.key')


def key_shape(path):
    """返回 (ok, why)。只判形状与权限，不打印内容。
    Returns (ok, why). Checks shape and mode only; never prints the content."""
    try:
        st = os.stat(path)
    except OSError:
        return False, '缺失'
    if (st.st_mode & 0o777) != 0o600:
        return False, '权限=%o（须 600）' % (st.st_mode & 0o777)
    try:
        val = open(path, encoding='utf-8').read().strip()
    except OSError as e:
        return False, '不可读：%s' % type(e).__name__
    if not val:
        return False, '空文件'
    if not KEY_RE.match(val):
        return False, '内容不是 64 位 hex'
    return True, '600/64hex'


def ensure_identity(name):
    rows = registry()
    for r in rows:
        if r['name'] == name:
            k = key_path(r['id'])
            ok, why = key_shape(k)
            if not ok:
                die('密钥 %s' % name, '%s（%s）' % (k, why))
            out('GREEN 身份：%s / %s（密钥 %s）' % (name, r['id'], why))
            return r['id']
    orch = os.path.join(RUNTIME, 'daybook-orch', 'orchestrator.py')
    if not os.path.exists(orch):
        die('注册身份', '找不到 orchestrator：%s' % orch)
    # --quiet：注册卷写密钥文件 600，secret 不回显、不进本进程输出
    r = subprocess.run([PY, orch, '--home', LEDGER, 'join', name, '--quiet'],
                       text=True, capture_output=True, timeout=60)
    if r.returncode != 0:
        die('注册身份 %s' % name, (r.stderr or r.stdout)[-300:])
    rows = registry()
    for x in rows:
        if x['name'] == name:
            k = key_path(x['id'])
            ok, why = key_shape(k)
            if not ok:
                die('密钥 %s' % name, '%s（%s）' % (k, why))
            out('GREEN 身份：%s / %s（本机生成·密钥 %s）' % (name, x['id'], why))
            return x['id']
    die('注册身份 %s' % name, 'join 后注册卷仍无该身份')


def signer_source():
    for cand in (os.path.join(PKG_ROOT, 'signer'),
                 os.path.join(SOURCE, 'daybook-mcp', 'signer')):
        if os.path.exists(os.path.join(cand, 'proxy.py')):
            return cand
    return ''


def install_signer(st):
    src = signer_source()
    if not src:
        die('签名代理', '发行包未带 signer/（proxy.py 缺失）')
    os.makedirs(SIGNER_DIR, exist_ok=True)
    changed = 0
    for name in ('proxy.py', 'daybook-signer', 'verify_audit.py', 'README.md'):
        s = os.path.join(src, name)
        if not os.path.exists(s):
            continue
        d = os.path.join(SIGNER_DIR, name)
        want = sha256_file(s)
        if os.path.exists(d) and sha256_file(d) == want:
            continue
        if os.path.exists(d):
            backup(d, st)
        shutil.copy2(s, d)
        changed += 1
    os.chmod(os.path.join(SIGNER_DIR, 'daybook-signer'), 0o755)
    out('GREEN 签名代理：%s' % ('无变化' if changed == 0 else '已安装 %d 件' % changed))


