    return {
        'DAYBOOK_BASE': BASE,
        'DAYBOOK_ROOT': LEDGER,
        'DAYBOOK_SERVER': os.path.join(RUNTIME, 'daybook-mcp', 'mcp_server.py'),
        'DAYBOOK_AUDIT_BASE': BASE,
